# The module ships shell scripts that /system/bin/sh executes directly, and a
# WebUI the manager loads verbatim. core.autocrlf=true on a Windows clone would
# check these out with CRLF, and a local package.sh run would zip them that way —
# a \r on the shebang line or after a `then` breaks the script on-device (the
# same class of failure as the CRLF'd ksud installer.sh). Pin them.
*.sh        text eol=lf
*.rs        text eol=lf
*.c         text eol=lf
*.h         text eol=lf
*.html      text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.toml      text eol=lf
*.lock      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.patch     -text
module.prop text eol=lf
